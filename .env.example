# SSO-only: no app password. Edge (Traefik ForwardAuth -> Authentik) gates all UI/API.
TRUST_PROXY_AUTH=1
SSO_ONLY=1
AUTH_URL=https://auth.rajlabs.in
# ADMIN_PASSWORD + SECRET_KEY only matter if SSO_ONLY=0 (local dev, direct access).
ADMIN_PASSWORD=
SECRET_KEY=change-me-32-chars-min
HONEYPOT_HOST=0.0.0.0
HONEYPOT_PORT=2222
API_PORT=8078
DATA_DIR=/srv/data
# Storage bounds
RETENTION_DAYS=2
MAX_DB_GB=10
JSONL_MAX_MB=100
JSONL_KEEP=3
# Optional Postgres (shared dev-postgres, honey/honey DB):
# DATABASE_URL=postgresql://honey:CHANGE_ME@dev-postgres:5432/honey
